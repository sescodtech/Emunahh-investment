# Browser-safe Vite variables only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://emunahhinvest.com

# Public website media uploads only (not protected application documents)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# IMPORTANT: Never place service-role, Resend, Cloudinary API secret,
# or Google Drive service-account credentials in VITE_* variables.
# Those belong in Supabase Edge Function Secrets.
