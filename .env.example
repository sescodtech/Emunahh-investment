# Vite production variables (preferred)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SITE_URL=https://emunahhinvest.com

# Cloudinary public configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# BACKWARD COMPATIBILITY ONLY:
# If Vercel currently has these old names, the app accepts them temporarily.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Edge Function secrets — NEVER put these in Vercel frontend variables:
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=...
